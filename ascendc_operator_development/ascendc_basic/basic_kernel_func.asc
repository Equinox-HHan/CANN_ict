#include"acl/acl.h"
#include"kernek_operator.h"

__global__ __vector__ void Hello_world_func(){
    AscendC::printf("[Block:%ld/%ld]:Hello World",AscendC::GetBlockIdx(),AscendC::GetBlockNum());
}

int main(){
    aclInit(nullptr);
    int32_t deviceID=0;
    aclrtSetDevice(deviceID);
    aclrtStream stream=nullptr;
    aclrtCreateStream(&stream);
    constexpr uint32_t blockDim=4;
    Hello_world_func<<<blockDim,nullptr,stream>>>();
    aclrtSynchronizeStream(stream);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceID);
    aclFinalize();
    return 0;
}