#include "acl/acl.h"
#include "kernel_operator.h"
#include<cstdint>
#include<iostream>
#include<algorithm>
#include<vector>
#include<iterator>

//为实现DoubleBuffer设置内存块个数
constexpr uint32_t BUFFER_NUM=2;
constexpr uint32_t QUEUE_DEPTH=2;

struct AddCustomTilingData{
    uint32_t totalLength;//需要计算的总数据量
    uint32_t tileNum;//切成多少分片循环处理
};

__global__ __aicore__ void add_custom(GM_ADDR x,GM_ADDR y,GM_ADDR z,AddCustomTilingData tiling){
    //此处参数使用宏封装
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);//声明为矢量计算内核
    KernelAdd op;//实例化算子类
    op.Init(x,y,z,tiling.totalLength,tiling.tileNum);//初始化并传入切分策略
    op.Process();
}

//AscendC算子类
class KernelAdd{
    public:
        __aicore__ inline KernelAdd(){}//初始化函数，完成内存初始化
        __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum);
        __aicore__ inline void Process();//核心处理函数
    private:
        __aicore__ inline void CopyIn(int32_t progress);//数据搬入函数
        __aicore__ inline void Compute(int32_t progress);//计算函数
        __aicore__ inline void CopyOut(int32_t progress);//数据搬出函数
    private:    
        //核心数据成员
        AscendC::TPipe pipe;//内存管理对象
        AscendC::TQue<AscendC::TPosition::VECIN,QUEUE_DEPTH> inQueueX,inQueueY;//输入数据队列管理对象
        AscendC::TQue<AscendC::TPosition::VECOUT,QUEUE_DEPTH> outQueueZ;//输出数据队列管理对象
        AscendC::GlobalTensor<float> xGm;//管理输入输出GM内存地址的对象
        AscendC::GlobalTensor<float> yGm;
        AscendC::GlobalTensor<float> zGm;
        //数据切分参数
        uint32_t blockLength;
        uint32_t tileNum;
        uint32_t tileLength;
};

__aicore__ inline void KernelAdd::Init(GM_ADDR x,GM_ADDR y,GM_ADDR z,uint32_t totalLength, uint32_t tileNum){
    this->blockLength=totalLength/AscendC::GetBlockNum();//计算每个核需要处理的长度
    this->tileNum=tileNum;
    this->tileLength=this->blockLength/tileNum/BUFFER_NUM;//单核内的数据切分
    //设置每个核的起始地址
    xGm.SetGlobalBuffer((__gm__ float*)x+this->blockLength*AscendC::GetBlockIdx(),this->blockLength);
    yGm.SetGlobalBuffer((__gm__ float*)y+this->blockLength*AscendC::GetBlockIdx(),this->blockLength);
    zGm.SetGlobalBuffer((__gm__ float*)z+this->blockLength*AscendC::GetBlockIdx(),this->blockLength);
    //为队列分配内存
    pipe.InitBuffer(inQueueX,BUFFER_NUM,this->tileLength*sizeof(float));
    pipe.InitBuffer(inQueueY,BUFFER_NUM,this->tileLength*sizeof(float));
    pipe.InitBuffer(outQueueZ,BUFFER_NUM,this->tileLength*sizeof(float));
}

__aicore__ inline void KernelAdd::Process(){
    int32_t loopCount=this->tileNum*BUFFER_NUM;
    for(int32_t i=0;i<loopCount;i++){
        CopyIn(i);
        Compute(i);
        CopyOut(i);
    }
}

//1.使用DataCopy将GlobalTensor数据移动到LocalTensor
//2.使用EnQue将LocalTensor放入Vecin队列中
__aicore__ inline void KernelAdd::CopyIn(int32_t progress){
    //为LocalTensor分配内存
    AscendC::LocalTensor<float> xLocal=inQueueX.AllocTensor<float>();
    AscendC::LocalTensor<float> yLocal=inQueueY.AllocTensor<float>();
    //计算当前数据起始位置从GM搬运到LM
    AscendC::DataCopy(xLocal,xGm[progress*this->tileLength],this->tileLength);
    AscendC::DataCopy(yLocal,yGm[progress*this->tileLength],this->tileLength);
    //将数据放入队列通知Compute
    inQueueX.EnQue(xLocal);
    inQueueY.EnQue(yLocal);
}

//1.使用DeQue从Vecin队列中取出LocalTensor
//2.使用API接口完成矢量计算
//3.使用EnQue将计算结果LocalTensor放入Vecout队列中
//4.使用FreeTensor释放不适用的LocalTensor
__aicore__ inline void KernelAdd::Compute(int32_t progress){
    AscendC::LocalTensor<float> xLocal=inQueueX.DeQue<float>();
    AscendC::LocalTensor<float> yLocal=inQueueY.DeQue<float>();
    AscendC::LocalTensor<float> zLocal=outQueueZ.AllocTensor<float>();
    AscendC::Add(zLocal,xLocal,yLocal,this->tileLength);
    outQueueZ.EnQue<float>(zLocal);
    inQueueX.FreeTensor(xLocal);
    inQueueY.FreeTensor(yLocal);
}

//1.使用DeQue从Vecout队列中取出LocalTensor
//2.将数据从LM拷贝到GM
//3.对LocalTensor进行回收
__aicore__ inline void KernelAdd::CopyOut(int32_t progress){
    AscendC::LocalTensor<float> zLocal=outQueueZ.DeQue<float>();
    AscendC::DataCopy(zGm[progress*this->tileLength],zLocal,this->tileLength);
    outQueueZ.FreeTensor(zLocal);
}

//完成Kernel侧核函数后编写Host侧程序调用算子
//1.初始化运行环境
//2.申请运行时资源
//3.分配host侧内存后数据初始化
//4.分配device侧内存然后拷贝数据
//5.调用核函数
//6.拷贝回运算结果
//7.释放申请的资源后去初始化
std::vector<float> kernel_add(std::vector<float> &x,std::vector<float> &y){
    constexpr uint32_t blockDim=8;
    uint32_t totalLength=x.size();
    size_t totalByteSize=totalLength*sizeof(float);
    int32_t deviceID=0;
    aclrtStream stream=nullptr;//用于异步任务管理的计算流
    AddCustomTilingData tiling={totalLength,8};
    //Host侧数据指针
    uint8_t *xHost=reinterpret_cast<uint8_t *>(x.data());
    uint8_t *yHost=reinterpret_cast<uint8_t *>(y.data());
    uint8_t *zHost=nullptr;
    //device侧数据指针
    uint8_t *xDevice=nullptr;
    uint8_t *yDevice=nullptr;
    uint8_t *zDevice=nullptr;

    aclInit(nullptr);

    aclrtSetDevice(deviceID);
    aclrtCreateStream(&stream);//创建计算流

    aclrtMallocHost((void**)(&zHost),totalByteSize);//在host侧为结果分配内存
    aclrtMalloc((void**)&xDevice,totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice,totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zDevice,totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(xDevice,totalByteSize,xHost,totalByteSize,ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDevice,totalByteSize,yHost,totalByteSize,ACL_MEMCPY_HOST_TO_DEVICE);

    add_custom<<<blockDim,nullptr,stream>>>(xDevice,yDevice,zDevice,tiling);
    aclrtSynchronizeStream(stream);//等待同步

    aclrtMemcpy(zHost,totalByteSize,zDevice,totalByteSize,ACL_MEMCPY_DEVICE_TO_HOST);
    vector<float> z((float*)zHost,(float*)(zHost+totalByteSize));
    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(zHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceID);

    aclFinalize();
    return z;
} 

int32_t main(int32_t argc,char *argv[]){
    constexpr uint32_t totalLength=8*2048;
    constexpr float valueX=1.2f;
    constexpr float valueY=2.3f;
    std::vector<float> x(totalLength,valueX);
    std::vector<float> y(totalLength,valueY);

    vector<float> output=kernel_add(x,y);
    return 0;
}